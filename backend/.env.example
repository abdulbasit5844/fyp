NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/dms
MQTT_URL=mqtt://127.0.0.1:1883

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Where the edge pipeline writes event clips. Clip streaming is limited to this folder.
CLIPS_DIR=/var/lib/dms/clips

# Optional HTTPS (SEC-1). Leave empty to serve plain HTTP on the local network.
TLS_CERT=
TLS_KEY=

# Optional Firebase Cloud Messaging: path to the service-account JSON.
FIREBASE_SERVICE_ACCOUNT=

# Optional Twilio SMS fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
